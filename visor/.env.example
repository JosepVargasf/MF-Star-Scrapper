# Firebase Auth — copiar este archivo como .env y rellenar con los valores del proyecto Firebase
# Las variables VITE_ son expuestas al frontend por Vite (no agregar secrets sensibles aquí)

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Dominio permitido para login (solo cuentas de este dominio pueden acceder)
VITE_ALLOWED_DOMAIN=situ.cl
